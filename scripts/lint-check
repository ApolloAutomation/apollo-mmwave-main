#!/bin/sh

# script/lint-check: Check linting without making changes.

set -e

cd "$(dirname "$0")/.."

# Ruff comes from the venv scripts/bootstrap installs requirements.txt into.
if [ ! -x .venv/bin/ruff ]; then
  echo ".venv/bin/ruff not found: run scripts/bootstrap first" >&2
  exit 1
fi

echo "==> Checking code format..."
.venv/bin/ruff format . --check

echo "==> Checking code with Ruff..."
.venv/bin/ruff check .

echo "==> Linting check completed!"
