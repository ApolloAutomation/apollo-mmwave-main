{
  "name": "apollo-mmwave-frontend",
  "version": "2.2.7",
  "type": "module",
  "description": "Apollo mmWave Lovelace frontend (radar tuning cards + dashboard strategy), bundled into the apollo_mmwave integration",
  "license": "MIT",
  "scripts": {
    "build": "vite build && vite build --config vite.zone-map.config.ts",
    "watch": "npm run watch:tuning & npm run watch:zone-map & wait",
    "watch:tuning": "vite build --watch",
    "watch:zone-map": "vite build --watch --config vite.zone-map.config.ts",
    "test": "vitest run",
    "test:bundles": "vitest run --config vitest.bundles.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
